---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  brand: CollectionEntry<"brands">["data"];
  pitch: CollectionEntry<"locations">["data"] | null;
}

const { brand, pitch } = Astro.props;

const wordmark = brand.name.replace(/^Simply\s+/i, "");
---

<a
  href={`/${brand.slug}/`}
  class="panel"
  data-brand={brand.slug}
  aria-labelledby={`panel-${brand.slug}-heading`}
>
  {
    brand.showcaseImage ? (
      <div class="panel__photo-wrap" aria-hidden="true">
        <Image
          src={brand.showcaseImage}
          alt=""
          class="panel__photo"
          widths={[400, 600, 800, 1200]}
          sizes="(min-width: 1200px) 20vw, (min-width: 900px) 30vw, (min-width: 600px) 46vw, 80vw"
          loading="lazy"
          quality={75}
        />
      </div>
    ) : null
  }

  <div class="panel__content">
    <p class="t-caption panel__kicker">Simply</p>
    <h3 id={`panel-${brand.slug}-heading`} class="t-display panel__wordmark">{wordmark}</h3>
    <p class="t-body panel__tagline">{brand.tagline}</p>
    {
      pitch && (
        <p class="t-caption panel__meta">
          {pitch.name}
          <span class="panel__meta-postcode"> · {pitch.postcode}</span>
        </p>
      )
    }
    <span class="panel__cta" aria-hidden="true">
      <span class="panel__cta-long">Visit Simply {wordmark}</span>
      <span class="panel__cta-short">Visit</span>
      <span class="panel__cta-arrow">→</span>
    </span>
  </div>
</a>

<style>
  /* Every card shares one horizon — the line where the photo yields to the
     brand colour — so the five cards read as a set: kickers on one line,
     colour blocks starting on one line, CTAs on one line. The text block is
     anchored to that horizon (not floated up from the bottom by however
     much copy it holds) and the CTA is pinned to the bottom edge. */
  .panel {
    --panel-horizon: 40%;
    --panel-pad: clamp(var(--sp-3), 9cqi, var(--sp-5));
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    aspect-ratio: 2 / 3;
    text-decoration: none;
    isolation: isolate;
    transition: transform var(--dur-base) var(--ease-out);
    /* Type and spacing scale with the card slot, not the viewport. */
    container-type: inline-size;
  }

  .panel:hover,
  .panel:focus-visible {
    transform: translateY(-4px);
  }

  /* Short CTA label is off by default; the ≤250px tier below switches it on
     (declared first so the container rule wins the cascade). */
  .panel__cta-short {
    display: none;
  }

  /* Proportion tiers by slot width, so the text block always fits below the
     horizon: ≤300px (phones, tablet 2-up, five-across) go poster-ratio with a
     smaller tagline; ≤250px (five-across on laptops) also drop the tagline
     and postcode and use the short CTA label. */
  @container (max-width: 300px) {
    .panel {
      aspect-ratio: 5 / 9;
    }
    .panel__tagline {
      font-size: var(--fs-200);
    }
  }
  @container (max-width: 250px) {
    .panel__tagline,
    .panel__meta-postcode,
    .panel__cta-long {
      display: none;
    }
    .panel__cta-short {
      display: inline;
    }
  }

  /* Photo band — from the top down to just past the horizon, fading out
     across its last fifth so the photo dissolves into the colour block
     rather than stopping at a hard edge. */
  .panel__photo-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--panel-horizon) + 10%);
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 80%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 80%, transparent 100%);
  }

  /* :global() pierces Astro Image's component-scoped class. */
  :global(.panel__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Each brand stylesheet may override --panel-photo-position to put the
       food in the visible band. Default crops toward the bottom. */
    object-position: var(--panel-photo-position, center 85%);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .panel:hover :global(.panel__photo),
  .panel:focus-visible :global(.panel__photo) {
    transform: scale(1.04);
  }

  /* Brand tint: a light cast at the top, clear through the photo, then a
     ramp to solid colour that lands exactly on the horizon. */
  .panel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-accent) 18%, transparent) 0%,
      transparent 28%,
      color-mix(in srgb, var(--color-accent) 55%, transparent) var(--panel-horizon),
      color-mix(in srgb, var(--color-accent) 92%, transparent) calc(var(--panel-horizon) + 7%),
      var(--color-accent) calc(var(--panel-horizon) + 12%),
      var(--color-accent) 100%
    );
  }

  /* Text block: starts on the horizon, runs to the bottom edge. Its own
     backdrop fades in over the first fifth so the kicker sits on near-solid
     colour and the wordmark on solid. */
  .panel__content {
    position: absolute;
    inset: var(--panel-horizon) 0 0 0;
    z-index: 2;
    padding: var(--panel-pad);
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-accent) 88%, transparent) 10%,
      var(--color-accent) 20%,
      var(--color-accent) 100%
    );
  }

  .panel__kicker {
    color: var(--color-accent-contrast);
    margin-bottom: var(--sp-1);
  }

  .panel__wordmark {
    /* 18cqi with 9cqi side padding keeps an 8-letter wordmark (SHAWARMA,
       LEBANESE) inside the card at every width — measured, not eyeballed. */
    font-size: clamp(var(--fs-600), 18cqi, var(--fs-800));
    line-height: 0.86;
    letter-spacing: var(--ls-display-tight);
    text-transform: uppercase;
    color: var(--color-accent-contrast);
  }

  .panel__tagline {
    font-size: var(--fs-300);
    line-height: var(--lh-snug);
    color: var(--color-accent-contrast);
    max-width: 28ch;
    margin-top: var(--sp-2);
  }

  .panel__meta {
    color: var(--color-accent-contrast);
    margin-top: var(--sp-2);
  }

  .panel__cta {
    margin-top: auto; /* pins the CTA to the bottom edge on every card */
    padding-top: var(--sp-3);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--ff-body-stack);
    font-weight: var(--fw-strong);
    font-size: var(--fs-200);
    text-transform: uppercase;
    letter-spacing: var(--ls-caption);
    color: var(--color-accent-contrast);
    border-bottom: 2px solid var(--color-accent-contrast);
    padding-bottom: var(--sp-1);
    align-self: flex-start;
  }

  .panel__cta-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .panel:hover .panel__cta-arrow,
  .panel:focus-visible .panel__cta-arrow {
    transform: translateX(4px);
  }

  .panel:focus-visible {
    outline: 2px solid var(--color-accent-contrast);
    outline-offset: 3px;
  }
</style>
