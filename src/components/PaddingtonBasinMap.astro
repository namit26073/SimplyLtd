---
/**
 * Interactive map of Paddington Basin via Leaflet + CARTO tiles.
 * No API key, no billing, no Google branding.
 *
 * Pins come from the `locations` content collection (single source of truth)
 * — coordinates are postcode centroids verified against postcodes.io on
 * 2026-08-25. Each pin shows the logos of the trucks on that pitch, so a
 * visitor can see which truck is where without reading anything; the popup
 * offers a "Get directions" hand-off by address.
 */
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { directionsUrl } from "../lib/directions";
import { brandLogos, type BrandLogoSlug } from "../lib/brandLogos";

interface Props {
  locations: CollectionEntry<"locations">["data"][];
  /** Brands per location slug, e.g. { "merchant-square": [{ slug: "falafel", name: "Simply Falafel" }, …] }. */
  brandsBySlug: Record<string, { slug: string; name: string }[]>;
}

const { locations, brandsBySlug } = Astro.props;

const ACCENT: Record<string, string> = {
  "merchant-square": "green",
  "canal-side-walk": "red",
};

// Logo tiles render at 60px; 160px covers 2× screens with room to spare.
const logoSrc: Partial<Record<BrandLogoSlug, string>> = {};
for (const [slug, image] of Object.entries(brandLogos)) {
  const optimised = await getImage({
    src: image,
    width: 160,
    height: 160,
    format: "webp",
    quality: 82,
  });
  logoSrc[slug as BrandLogoSlug] = optimised.src;
}

const pins = locations.map((loc) => ({
  lat: loc.coordinates[1],
  lng: loc.coordinates[0],
  label: loc.name,
  accent: ACCENT[loc.slug] ?? "ink",
  brands: (brandsBySlug[loc.slug] ?? []).map((b) => ({
    name: b.name,
    logo: logoSrc[b.slug as BrandLogoSlug] ?? null,
  })),
  postcode: loc.postcode,
  directions: directionsUrl(loc.addressLines, loc.postcode),
}));

const center =
  pins.length > 0
    ? [
        pins.reduce((s, p) => s + p.lat, 0) / pins.length,
        pins.reduce((s, p) => s + p.lng, 0) / pins.length,
      ]
    : [51.519, -0.1748];
---

<div class="basin-map">
  <div
    id="basin-map"
    class="basin-map__canvas"
    role="application"
    aria-label={`Paddington Basin pitch map — ${pins.length} Simply Ltd locations marked`}
    data-pins={JSON.stringify(pins)}
    data-center={JSON.stringify(center)}
  >
  </div>
  <p class="basin-map__caption t-caption">
    {pins.length} pitches on Paddington Basin, about 250 metres apart. Tap a truck for directions.
  </p>
</div>

<style>
  .basin-map {
    width: 100%;
  }
  /* Portrait on phones so two logo pins 250 m apart both fit with air
     around them; widescreen from tablets up. */
  .basin-map__canvas {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 560px;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }
  @media (min-width: 600px) {
    .basin-map__canvas {
      aspect-ratio: 16 / 9;
    }
  }
  @media (min-width: 900px) {
    .basin-map__canvas {
      aspect-ratio: 16 / 8;
    }
  }
  .basin-map__caption {
    margin-top: var(--sp-3);
    color: var(--color-text-muted);
  }

  /* Pins (Leaflet divIcon): the truck logos in a white tray, the pitch name
     as a coloured tag beneath, and a nub pointing at the coordinate. The
     whole thing hangs above the point — translate(-50%, -100%) puts the nub's
     tip on it. Pin colours match the pitch cards' left rules. */
  :global(.basin-pin) {
    --pin-accent: var(--color-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: max-content;
    transform: translate(-50%, -100%);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.22));
  }
  :global(.basin-pin--green) {
    --pin-accent: #3f7a3a;
  }
  :global(.basin-pin--red) {
    --pin-accent: #c03020;
  }
  :global(.basin-pin__logos) {
    display: flex;
    gap: 4px;
    padding: 4px;
    background: #fff;
    border: 2px solid var(--pin-accent);
    border-radius: 18px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  :global(.basin-pin__logo) {
    display: block;
    width: 60px;
    height: 60px;
    border-radius: 12px;
    object-fit: cover;
    background: #fff;
  }
  :global(.basin-pin__label) {
    margin-top: -2px;
    padding: 5px 10px;
    background: var(--pin-accent);
    color: var(--color-cream);
    font-family: var(--ff-body-stack);
    font-weight: var(--fw-strong);
    font-size: 0.7rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    border-radius: var(--r-pill);
  }
  :global(.basin-pin::after) {
    content: "";
    width: 0;
    height: 0;
    border: 7px solid transparent;
    border-top-color: var(--pin-accent);
    margin-top: -2px;
  }
  /* Compact pins on phones: 44px logos, smaller tag. */
  @media (max-width: 599px) {
    :global(.basin-pin__logos) {
      gap: 3px;
      padding: 3px;
      border-radius: 14px;
    }
    :global(.basin-pin__logo) {
      width: 44px;
      height: 44px;
      border-radius: 10px;
    }
    :global(.basin-pin__label) {
      font-size: 0.62rem;
      padding: 4px 8px;
    }
  }
  :global(.leaflet-marker-icon:hover .basin-pin__logos),
  :global(.leaflet-marker-icon:focus-visible .basin-pin__logos) {
    transform: translateY(-2px);
  }
  :global(.leaflet-marker-icon:focus-visible) {
    outline: none;
  }
  :global(.leaflet-marker-icon:focus-visible .basin-pin__logos) {
    outline: 3px solid var(--color-ink);
    outline-offset: 3px;
  }

  /* Leaflet popup overrides to match brand. */
  :global(.leaflet-popup-content-wrapper) {
    border-radius: var(--r-md);
    padding: var(--sp-1);
  }
  :global(.leaflet-popup-content) {
    margin: var(--sp-3);
    font-family: var(--ff-body-stack);
    font-size: var(--fs-300);
  }
  :global(.leaflet-popup-content strong) {
    font-family: var(--ff-display-stack);
    font-weight: var(--fw-display);
    font-size: var(--fs-400);
    text-transform: uppercase;
    letter-spacing: var(--ls-display-tight);
    display: block;
    margin-bottom: var(--sp-1);
  }
  :global(.leaflet-popup-content .basin-directions) {
    display: inline-block;
    margin-top: var(--sp-2);
    font-weight: var(--fw-strong);
    color: var(--color-ink);
    text-underline-offset: 0.15em;
  }
</style>

<script>
  interface Pin {
    lat: number;
    lng: number;
    label: string;
    accent: string;
    brands: { name: string; logo: string | null }[];
    postcode: string;
    directions: string;
  }

  const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  // Leaflet (~46 KiB) and the tiles only load once the map is about to
  // scroll into view, so they never compete with the page's LCP text.
  async function buildMap(container: HTMLElement) {
    const { default: L } = await import("leaflet");

    const pins = JSON.parse(container.dataset.pins ?? "[]") as Pin[];
    const center = JSON.parse(container.dataset.center ?? "[51.519, -0.1748]") as [number, number];

    const map = L.map(container, {
      center,
      zoom: 17,
      scrollWheelZoom: false,
      zoomControl: true,
      attributionControl: true,
    });

    // OpenStreetMap's own raster tiles: free, no key, no cookies.
    //
    // We were on CARTO Voyager until 2026-09-03, when CARTO began stamping
    // "API KEY REQUIRED" across tiles served without a key — verified with a
    // plain curl carrying a browser User-Agent and Referer, so it is a policy
    // change and not rate limiting. OSM's tile usage policy permits low-volume
    // sites like this one; if traffic grows, move to a keyed provider
    // (MapTiler's free tier covers 100k tiles/month) rather than leaning on
    // OSMF's donated infrastructure. OSM serves 256px tiles only — no {r}
    // retina variant — which also trims bytes on phones.
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      subdomains: "abc",
      maxZoom: 19,
    }).addTo(map);

    for (const p of pins) {
      const logos = p.brands
        .filter((b) => b.logo)
        .map(
          (b) =>
            `<img class="basin-pin__logo" src="${b.logo}" alt="" width="60" height="60" decoding="async">`,
        )
        .join("");
      const names = p.brands.map((b) => escapeHtml(b.name)).join(" + ");
      const icon = L.divIcon({
        className: "",
        html:
          `<div class="basin-pin basin-pin--${p.accent}">` +
          `<span class="basin-pin__logos">${logos}</span>` +
          `<span class="basin-pin__label">${escapeHtml(p.label)}</span></div>`,
        iconSize: [0, 0],
        iconAnchor: [0, 0],
      });
      const marker = L.marker([p.lat, p.lng], { icon, alt: `${p.label} — ${names}` }).addTo(map);
      // The pin hangs above its coordinate, so lift the popup by the pin's
      // rendered height — otherwise it opens on top of the logos.
      const pinHeight =
        marker.getElement()?.querySelector<HTMLElement>(".basin-pin")?.offsetHeight ?? 100;
      marker.bindPopup(
        `<strong>${escapeHtml(p.label)}</strong>${names}<br/>${escapeHtml(p.postcode)}<br/>` +
          `<a class="basin-directions" href="${p.directions}" target="_blank" rel="noopener noreferrer">Get directions ↗</a>`,
        { offset: [0, -(pinHeight + 2)] },
      );
    }

    // Frame both pitches with room for the pins, which hang above their
    // coordinates (~105px tall on desktop, ~85px on phones, and up to ~150px
    // wide). On a phone that lands at zoom 16 rather than pushing a pin off
    // the edge or onto its neighbour.
    if (pins.length > 1) {
      const phone = container.clientWidth < 600;
      map.fitBounds(L.latLngBounds(pins.map((p) => [p.lat, p.lng] as [number, number])), {
        paddingTopLeft: phone ? [60, 110] : [90, 140],
        paddingBottomRight: phone ? [60, 30] : [90, 40],
        maxZoom: 17,
      });
    }
  }

  /**
   * Run once the page has finished loading and the main thread is free.
   *
   * On a phone the map sits ~500px down an 844px viewport, so it is already
   * intersecting at first paint and the observer fires immediately — Leaflet
   * plus ten tiles then compete with the page's own critical path. Measured
   * cost of not waiting: Lighthouse mobile 77 vs 95, entirely in simulated
   * LCP (the LCP element is the intro paragraph either way).
   */
  function whenIdle(run: () => void) {
    const idle = () => {
      if ("requestIdleCallback" in window) window.requestIdleCallback(run, { timeout: 2000 });
      else setTimeout(run, 200);
    };
    if (document.readyState === "complete") idle();
    else window.addEventListener("load", idle, { once: true });
  }

  function initBasinMap() {
    const container = document.getElementById("basin-map");
    if (!(container instanceof HTMLElement) || container.dataset.ready) return;
    container.dataset.ready = "true";

    whenIdle(() => {
      if (!("IntersectionObserver" in window)) {
        void buildMap(container);
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          void buildMap(container);
        },
        { rootMargin: "320px 0px" },
      );
      io.observe(container);
    });
  }

  initBasinMap();
  // ClientRouter swaps the DOM without re-running module scripts — re-init on navigation.
  document.addEventListener("astro:page-load", initBasinMap);
</script>
