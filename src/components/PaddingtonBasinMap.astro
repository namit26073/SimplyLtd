---
/**
 * Interactive map of Paddington Basin via Leaflet + OpenStreetMap tiles.
 * No API key, no billing, no Google branding.
 *
 * Pins come from the `locations` content collection (single source of truth)
 * — coordinates are postcode centroids verified against postcodes.io on
 * 2026-08-25. Each popup offers a "Get directions" hand-off by address.
 */
import type { CollectionEntry } from "astro:content";
import { directionsUrl } from "../lib/directions";

interface Props {
  locations: CollectionEntry<"locations">["data"][];
  /** Brand display names per location slug, e.g. { "merchant-square": ["Simply Falafel", …] }. */
  brandNamesBySlug: Record<string, string[]>;
}

const { locations, brandNamesBySlug } = Astro.props;

const ACCENT: Record<string, string> = {
  "merchant-square": "green",
  "canal-side-walk": "red",
};

const pins = locations.map((loc) => ({
  lat: loc.coordinates[1],
  lng: loc.coordinates[0],
  label: loc.name,
  accent: ACCENT[loc.slug] ?? "ink",
  brands: (brandNamesBySlug[loc.slug] ?? []).join(" + "),
  postcode: loc.postcode,
  directions: directionsUrl(loc.addressLines, loc.postcode),
}));

const center =
  pins.length > 0
    ? [
        pins.reduce((s, p) => s + p.lat, 0) / pins.length,
        pins.reduce((s, p) => s + p.lng, 0) / pins.length,
      ]
    : [51.519, -0.1748];
---

<div class="basin-map">
  <div
    id="basin-map"
    class="basin-map__canvas"
    role="application"
    aria-label={`Paddington Basin pitch map — ${pins.length} Simply Ltd locations marked`}
    data-pins={JSON.stringify(pins)}
    data-center={JSON.stringify(center)}
  >
  </div>
  <p class="basin-map__caption t-caption">
    {pins.length} pitches on Paddington Basin, about 250 metres apart. Tap a pin for directions.
  </p>
</div>

<style>
  .basin-map {
    width: 100%;
  }
  .basin-map__canvas {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 560px;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }
  @media (min-width: 900px) {
    .basin-map__canvas {
      aspect-ratio: 16 / 8;
    }
  }
  .basin-map__caption {
    margin-top: var(--sp-3);
    color: var(--color-text-muted);
  }

  /* Brand-coloured pin styles via Leaflet's divIcon. */
  :global(.basin-pin) {
    background: var(--color-ink);
    color: var(--color-cream);
    font-family: var(--ff-body-stack);
    font-weight: var(--fw-strong);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-pill);
    border: 2px solid var(--color-cream);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
    transform: translate(-50%, -100%);
  }
  :global(.basin-pin--green) {
    background: #3f7a3a;
  }
  :global(.basin-pin--red) {
    background: #c03020;
  }

  /* Leaflet popup overrides to match brand. */
  :global(.leaflet-popup-content-wrapper) {
    border-radius: var(--r-md);
    padding: var(--sp-1);
  }
  :global(.leaflet-popup-content) {
    margin: var(--sp-3);
    font-family: var(--ff-body-stack);
    font-size: var(--fs-300);
  }
  :global(.leaflet-popup-content strong) {
    font-family: var(--ff-display-stack);
    font-weight: var(--fw-display);
    font-size: var(--fs-400);
    text-transform: uppercase;
    letter-spacing: var(--ls-display-tight);
    display: block;
    margin-bottom: var(--sp-1);
  }
  :global(.leaflet-popup-content .basin-directions) {
    display: inline-block;
    margin-top: var(--sp-2);
    font-weight: var(--fw-strong);
    color: var(--color-ink);
    text-underline-offset: 0.15em;
  }
</style>

<script>
  import L from "leaflet";

  interface Pin {
    lat: number;
    lng: number;
    label: string;
    accent: string;
    brands: string;
    postcode: string;
    directions: string;
  }

  function initBasinMap() {
    const container = document.getElementById("basin-map");
    if (!(container instanceof HTMLElement) || container.dataset.ready) return;
    container.dataset.ready = "true";

    const pins = JSON.parse(container.dataset.pins ?? "[]") as Pin[];
    const center = JSON.parse(container.dataset.center ?? "[51.519, -0.1748]") as [number, number];

    const map = L.map(container, {
      center,
      zoom: 17,
      scrollWheelZoom: false,
      zoomControl: true,
      attributionControl: true,
    });

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map);

    for (const p of pins) {
      const icon = L.divIcon({
        className: "",
        html: `<span class="basin-pin basin-pin--${p.accent}">${p.label}</span>`,
        iconSize: [0, 0],
        iconAnchor: [0, 0],
      });
      L.marker([p.lat, p.lng], { icon })
        .addTo(map)
        .bindPopup(
          `<strong>${p.label}</strong>${p.brands}<br/>${p.postcode}<br/>` +
            `<a class="basin-directions" href="${p.directions}" target="_blank" rel="noopener noreferrer">Get directions ↗</a>`,
        );
    }
  }

  initBasinMap();
  // ClientRouter swaps the DOM without re-running module scripts — re-init on navigation.
  document.addEventListener("astro:page-load", initBasinMap);
</script>
