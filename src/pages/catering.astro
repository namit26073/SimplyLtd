---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import cateringHero from "../assets/placeholders/catering-hero.jpg";
import Catering from "../islands/forms/Catering.tsx";
---

<Base
  title="Catering"
  description="Simply Ltd catering — weddings, corporate, festivals, private parties. Past pitches include Hyde Park's Winter Wonderland. On-site cooking across London and the south-east."
>
  <article class="catering-page">
    {/* Hero — full-bleed photo, type overlay -------------------------------- */}
    <section class="catering-hero" aria-labelledby="catering-hero-heading">
      <div class="catering-hero__bg" aria-hidden="true">
        <Image
          src={cateringHero}
          alt=""
          class="catering-hero__photo"
          widths={[640, 1024, 1440, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          quality={75}
        />
        <div class="catering-hero__mask"></div>
      </div>

      <div class="catering-hero__content">
        <p class="t-caption catering-hero__kicker">Catering enquiries</p>
        <h1 id="catering-hero-heading" class="t-display catering-hero__heading">
          Bring street food to your event.
        </h1>
        <p class="t-editorial t-editorial--italic catering-hero__dek">
          Weddings, corporate days, festivals, private parties. We bring the trucks, the team,
          and the queue that doesn't stop.
        </p>
        <a href="#enquire" class="catering-hero__cta">
          Enquire below
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    {/* Credibility — single confident statement, no padding ----------------- */}
    <section class="credibility" aria-labelledby="credibility-heading">
      <div class="credibility__inner">
        <p class="t-caption credibility__kicker">Past pitches</p>
        <h2 id="credibility-heading" class="t-display credibility__heading">
          We've fed Hyde Park's <span class="credibility__highlight">Winter Wonderland</span>.
        </h2>
        <p class="t-editorial credibility__dek">
          Three trucks, operating from Paddington Basin since 2019. The crew that runs the
          pitches every day runs your event.
        </p>
      </div>
    </section>

    {/* How it works --------------------------------------------------------- */}
    <section class="process" aria-labelledby="process-heading">
      <div class="process__inner">
        <header class="process__header">
          <p class="t-caption">How it works</p>
          <h2 id="process-heading" class="t-display process__heading">From enquiry to event day.</h2>
        </header>

        <ol role="list" class="process__steps">
          <li class="step">
            <p class="t-display step__index" aria-hidden="true">1</p>
            <h3 class="t-display step__title">You send the form below</h3>
            <p class="t-body step__body">
              Date, location, guest count, vibe. The more you can tell us, the faster we can
              quote.
            </p>
          </li>
          <li class="step">
            <p class="t-display step__index" aria-hidden="true">2</p>
            <h3 class="t-display step__title">We reply within two working days</h3>
            <p class="t-body step__body">
              Quote, menu options, and any questions. Most enquiries are turned around same-week
              for events 8+ weeks out.
            </p>
          </li>
          <li class="step">
            <p class="t-display step__index" aria-hidden="true">3</p>
            <h3 class="t-display step__title">We finalise the menu together</h3>
            <p class="t-body step__body">
              Dietary requirements, special requests, branding. Allergens are documented in
              writing for every event.
            </p>
          </li>
          <li class="step">
            <p class="t-display step__index" aria-hidden="true">4</p>
            <h3 class="t-display step__title">Event day, we turn up early</h3>
            <p class="t-body step__body">
              Set up, prep, serve, pack down. You watch the queue not move because everything is
              running properly.
            </p>
          </li>
        </ol>
      </div>
    </section>

    {/* Lead time / coverage ------------------------------------------------- */}
    <section class="logistics" aria-labelledby="logistics-heading">
      <div class="logistics__inner">
        <header>
          <p class="t-caption">Lead time + coverage</p>
          <h2 id="logistics-heading" class="t-display logistics__heading">A few practical notes.</h2>
        </header>

        <div class="logistics__grid">
          <div class="logistics__item">
            <h3 class="t-caption logistics__label">Lead time</h3>
            <p class="t-body">
              Ideally 4+ weeks. We can sometimes turn around last-minute enquiries (under 14 days) —
              call us if you're in that window.
            </p>
          </div>
          <div class="logistics__item">
            <h3 class="t-caption logistics__label">Coverage</h3>
            <p class="t-body">
              London and the south-east as standard. We've travelled further for the right event;
              ask if you're outside the M25.
            </p>
          </div>
          <div class="logistics__item">
            <h3 class="t-caption logistics__label">Minimum size</h3>
            <p class="t-body">
              We cater 10 guests and up. Under that, you're better off coming to a truck.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Form ----------------------------------------------------------------- */}
    <section id="enquire" class="enquire" aria-labelledby="enquire-heading">
      <div class="enquire__inner">
        <header class="enquire__header">
          <p class="t-caption">Enquire</p>
          <h2 id="enquire-heading" class="t-display enquire__heading">
            Tell us about your event.
          </h2>
          <p class="t-editorial t-editorial--italic enquire__dek">
            We reply within two working days. For events in the next two weeks, give us a call
            instead.
          </p>
        </header>

        <div class="enquire__panel">
          <Catering client:visible />
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  /* Hero — full-bleed photo, type overlay on darkened gradient mask */
  .catering-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ink);
    color: var(--color-cream);
    min-height: 80vh;
    display: flex;
    align-items: flex-end;
  }
  @media (min-width: 900px) {
    .catering-hero {
      min-height: 86vh;
      align-items: center;
    }
  }
  .catering-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .catering-hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .catering-hero__mask {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-ink) 38%, transparent) 0%,
        color-mix(in srgb, var(--color-ink) 52%, transparent) 40%,
        color-mix(in srgb, var(--color-ink) 85%, transparent) 80%,
        color-mix(in srgb, var(--color-ink) 95%, transparent) 100%
      );
  }
  @media (min-width: 900px) {
    .catering-hero__mask {
      background:
        linear-gradient(
          100deg,
          color-mix(in srgb, var(--color-ink) 92%, transparent) 0%,
          color-mix(in srgb, var(--color-ink) 70%, transparent) 40%,
          color-mix(in srgb, var(--color-ink) 18%, transparent) 80%,
          transparent 100%
        );
    }
  }
  .catering-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--sp-7) var(--page-gutter) var(--sp-6);
  }
  @media (min-width: 900px) {
    .catering-hero__content {
      padding: var(--sp-7) var(--page-gutter);
    }
    .catering-hero__content > * { max-width: 22ch; }
    .catering-hero__dek { max-width: 38ch; }
    .catering-hero__cta { max-width: none; }
  }
  .catering-hero__kicker {
    color: var(--color-cream);
    margin-bottom: var(--sp-3);
  }
  .catering-hero__heading {
    font-size: clamp(var(--fs-700), 8vw, var(--fs-900));
    line-height: 0.92;
    letter-spacing: var(--ls-display-tight);
    color: var(--color-cream);
  }
  .catering-hero__dek {
    margin-top: var(--sp-4);
    font-size: var(--fs-400);
    color: var(--color-cream);
  }
  .catering-hero__cta {
    margin-top: var(--sp-5);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: var(--color-cream);
    color: var(--color-ink);
    font-family: var(--ff-body-stack);
    font-weight: var(--fw-strong);
    font-size: var(--fs-200);
    text-transform: uppercase;
    letter-spacing: var(--ls-caption);
    text-decoration: none;
    border-radius: var(--r-pill);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .catering-hero__cta:hover,
  .catering-hero__cta:focus-visible {
    transform: translateY(-1px);
    background: #fff;
  }
  .catering-hero :focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }

  /* Shared section frame */
  .credibility, .process, .logistics, .enquire {
    padding: var(--sp-7) var(--page-gutter);
    border-top: 1px solid var(--color-line);
  }
  .credibility { background: var(--color-paper); }
  .process { background: var(--color-cream); }
  .logistics { background: var(--color-paper); }
  .enquire { background: var(--color-cream); }
  .credibility__inner, .process__inner, .logistics__inner, .enquire__inner {
    max-width: var(--page-max);
    margin: 0 auto;
  }
  .process__header, .enquire__header {
    margin-bottom: var(--sp-5);
  }

  .process__heading, .logistics__heading, .enquire__heading {
    font-size: clamp(var(--fs-600), 6vw, var(--fs-700));
    line-height: 1;
    margin-top: var(--sp-2);
  }

  /* Credibility — single editorial statement, the page's first proof point */
  .credibility {
    padding-block: var(--sp-6);
  }
  @media (min-width: 720px) {
    .credibility { padding-block: var(--sp-7); }
  }
  .credibility__kicker {
    color: var(--color-text-muted);
    margin-bottom: var(--sp-3);
  }
  .credibility__heading {
    font-size: clamp(var(--fs-700), 7vw, var(--fs-800));
    line-height: 1;
    letter-spacing: var(--ls-display-tight);
    max-width: 22ch;
  }
  .credibility__highlight {
    font-family: var(--ff-editorial-stack);
    font-style: italic;
    font-weight: var(--fw-editorial);
    text-transform: none;
    letter-spacing: normal;
  }
  .credibility__dek {
    margin-top: var(--sp-4);
    font-size: var(--fs-400);
    max-width: 56ch;
    line-height: var(--lh-relaxed);
    color: color-mix(in srgb, var(--color-ink) 78%, transparent);
  }

  /* Process steps */
  .process__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
    counter-reset: step;
  }
  @media (min-width: 720px) {
    .process__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .process__steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .step__index {
    font-size: var(--fs-800);
    line-height: 1;
    color: var(--color-text-muted);
  }
  .step__title {
    font-size: var(--fs-500);
    line-height: 1;
  }
  .step__body {
    font-size: var(--fs-300);
    line-height: var(--lh-relaxed);
  }

  /* Logistics */
  .logistics__grid {
    margin-top: var(--sp-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }
  @media (min-width: 720px) {
    .logistics__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .logistics__item {
    padding: var(--sp-4);
    background: var(--color-cream);
    border-radius: var(--r-md);
  }
  .logistics__label {
    color: var(--color-text-muted);
    margin-bottom: var(--sp-2);
  }

  /* Enquire */
  .enquire__dek {
    margin-top: var(--sp-3);
    max-width: 50ch;
    color: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }
  .enquire__panel {
    margin-top: var(--sp-5);
    padding: var(--sp-5);
    background: var(--color-paper);
    border-radius: var(--r-lg);
    border: 1px solid var(--color-line);
    max-width: 760px;
  }
  @media (min-width: 720px) {
    .enquire__panel {
      padding: var(--sp-6);
    }
  }
</style>
