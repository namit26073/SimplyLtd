# ─── Instagram grid (build-time fetch) ────────────────────────────────────
# Meta Graph API credentials for the @simplyltd Instagram fetch.
# Resolved once via the Meta App / Graph API Explorer — see
# docs/runbooks/instagram-setup.md for the full setup.
#
# When absent (local dev without secrets), the build falls back to
# the committed set under src/content/instagram-fallback/.

IG_USER_ID=
IG_ACCESS_TOKEN=

# ─── Form delivery (Pages Function runtime) ───────────────────────────────
# Destinations for the catering + franchising enquiry forms. Functions in
# functions/api/ read these at request time. Unset → defaults to
# namitg26@gmail.com so local dev still routes somewhere.

CATERING_EMAIL=
FRANCHISE_EMAIL=

# Resend transactional email. Required for production delivery; when
# unset the function returns mock-success and the submission is logged
# (without PII) so dev iteration still works. See
# docs/runbooks/catering-forms-setup.md for full setup + key issuance.

RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Cloudflare Turnstile. Optional in dev — the React island sends a
# "dev-bypass" token the function accepts when this is unset. Required
# for prod (otherwise unverified submissions are rejected).

TURNSTILE_SECRET_KEY=
